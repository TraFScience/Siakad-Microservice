		{
			"name": "02 - Register Mahasiswa",
			"item": [
				{
					"name": "POST Mahasiswa Bunga (23010001) - 201 Created",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 201 Created', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"pm.test('Body sukses true', function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json.sukses).to.be.true;",
									"    pm.expect(json.data.nim).to.eql('23010001');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"url": "http://localhost:8081/api/v1/mahasiswa",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nim\": \"23010001\",\n  \"nama\": \"Bunga\",\n  \"jurusan\": \"Teknik Informatika\",\n  \"status\": \"Aktif\"\n}"
						}
					}
				},
				{
					"name": "POST Mahasiswa Bunga (23010001) Duplikat - 409 Conflict",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 409 Conflict', function () {",
									"    pm.response.to.have.status(409);",
									"});",
									"pm.test('Error message tentang NIM terdaftar', function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json.error).to.include('terdaftar');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
