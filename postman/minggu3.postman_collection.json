		{
			"name": "05 - Rekap Service",
			"item": [
				{
					"name": "GET Rekap Per Jurusan - 200 OK",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Data terkelompok per jurusan', function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json.sukses).to.be.true;",
									"    pm.expect(json.data).to.have.property('Teknik Informatika');",
									"    pm.expect(json.data).to.have.property('Sistem Informasi');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"url": "http://localhost:8082/api/v1/rekap/jurusan"
					}
				},
				{
					"name": "GET Top IPK (n=2) - 200 OK",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Mengembalikan 2 mahasiswa IPK tertinggi', function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json.data).to.be.an('array').with.lengthOf(2);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"url": {
							"raw": "http://localhost:8082/api/v1/rekap/top-ipk?n=2",
							"query": [{ "key": "n", "value": "2" }],
							"host": "http://localhost:8082/api/v1/rekap/top-ipk"
						}
					}
				},
				{
					"name": "GET Ringkasan Mahasiswa Tidak Ada - 404",
