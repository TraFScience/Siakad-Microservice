			"name": "01 - Health Checks",
			"item": [
				{
					"name": "Health Check Akademik Service (8081)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Body status ok', function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json.status).to.eql('ok');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"url": {
							"raw": "http://localhost:8081/health",
							"host": ["http://localhost:8081/health"],
							"path": "health"
						}
					}
				},
